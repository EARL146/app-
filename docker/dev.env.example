# Copy this file to docker/.env and replace all three placeholders with unique random values.
MYSQL_DATABASE=burger_bites_docker
MYSQL_USER=burger_bites_app
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
APP_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
APP_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
API_PORT=8082
MYSQL_PORT=3307
ORDER_TAX_PERCENT=12
ORDER_DELIVERY_FEE=25.00
