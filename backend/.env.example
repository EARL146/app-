# Copy to .env and fill in the local secret values.
# BurgerBites schema is installed in the confirmed AMPPS database burger_bites.
APP_ENV=local
APP_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
APP_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=burger_bites;charset=utf8mb4
DB_USERNAME=burger_bites_app
DB_PASSWORD=replace-me
ORDER_TAX_PERCENT=12
ORDER_DELIVERY_FEE=25.00
