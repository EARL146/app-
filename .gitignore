# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Graphify output can contain source text and local file paths
/graphify-out/

# ICM project memory is local user context, not repository content
/.icm/

# Local agent run history is private workstation state
/tools/agent-monitor/.state/

# Local secrets (keep template files such as .env.example trackable)
.env
.env.*
!.env.example

# Obsidian's machine-local pane and workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
